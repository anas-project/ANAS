acl trusted-networks {
    127.0.0.0/8;
    ::1;
    ${SAMBA_DC_DNS_ALLOWED_NETWORKS}
};

options {
    directory "/var/cache/bind";
    listen-on port 53 { 127.0.0.1; ${SAMBA_DC_DNS_SERVER}; };
    listen-on-v6 { any; };
    auth-nxdomain no;
    // BIND sizes its cache at 90% of total host memory by default, which
    // assumes it owns the machine. Here it is one container among many on a
    // shared host, and on a small host that default asks for more than is
    // available and aborts during cache setup. A domain controller resolving
    // for its own services needs a fraction of that.
    max-cache-size ${SAMBA_DC_DNS_CACHE_SIZE};
    recursion yes;
    allow-query { trusted-networks; };
    allow-query-cache { trusted-networks; };
    allow-recursion { trusted-networks; };
    allow-transfer { none; };
    // Secure AD dynamic updates are authorized by the Samba DLZ module.
    forwarders {
        ${SAMBA_DC_DNS_FORWARDERS}
    };
    dnssec-validation auto;
    empty-zones-enable no;
    minimal-responses yes;
    pid-file "/run/named/named.pid";
    session-keyfile "/run/named/session.key";
    tkey-gssapi-keytab "/var/lib/samba/private/dns.keytab";
};

zone "localhost" {
    type primary;
    file "master/localhost.zone";
};

zone "0.0.127.in-addr.arpa" {
    type primary;
    file "master/0.0.127.zone";
};

include "/var/lib/samba/bind-dns/named.conf";
