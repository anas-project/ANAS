@@ -87,0 +70,24 @@ func generateLogoutToken(application *Application, user *User, sessionId string,
+func newLogoutTokenClaims(application *Application, user *User, sessionId string, issuer string, nowTime time.Time) LogoutTokenClaims {
+
+	events := map[string]interface{}{
+		"http://schemas.openid.net/event/backchannel-logout": map[string]interface{}{},
+	}
+
+	claims := LogoutTokenClaims{
+		Events: events,
+		RegisteredClaims: jwt.RegisteredClaims{
+			Issuer:    issuer,
+			Subject:   user.Id,
+			Audience:  []string{application.ClientId},
+			ExpiresAt: jwt.NewNumericDate(nowTime.Add(2 * time.Minute)),
+			IssuedAt:  jwt.NewNumericDate(nowTime),
+			ID:        util.GetId(application.Owner, util.GenerateId()),
+		},
+	}
+
+	if sessionId != "" {
+		claims.Sid = sessionId
+	}
+	return claims
+}
+
diff --git a/object/token_logout_test.go b/object/token_logout_test.go
new file mode 100644
index 0000000..247fb00
--- /dev/null
+++ b/object/token_logout_test.go
@@ -0,0 +1,36 @@
+package object
+
+import (
+	"testing"
+	"time"
+)
+
+func TestNewLogoutTokenClaims(t *testing.T) {
+	now := time.Unix(1_800_000_000, 0)
+	claims := newLogoutTokenClaims(
+		&Application{Owner: "admin", ClientId: "nextcloud"},
+		&User{Id: "directory-user-id"},
+		"session-id",
+		"https://auth.example.test",
+		now,
+	)
+	if claims.Issuer != "https://auth.example.test" || claims.Subject != "directory-user-id" {
+		t.Fatalf("logout identity claims = %#v", claims)
+	}
+	if len(claims.Audience) != 1 || claims.Audience[0] != "nextcloud" || claims.Sid != "session-id" {
+		t.Fatalf("logout audience/session claims = %#v", claims)
+	}
+	if claims.IssuedAt == nil || !claims.IssuedAt.Time.Equal(now) || claims.ExpiresAt == nil || !claims.ExpiresAt.Time.Equal(now.Add(2*time.Minute)) {
+		t.Fatalf("logout time claims = %#v", claims)
+	}
+	if claims.ID == "" || claims.Events["http://schemas.openid.net/event/backchannel-logout"] == nil {
+		t.Fatalf("logout replay/event claims = %#v", claims)
+	}
+}
+
+func TestCustomClaimsIncludeSessionID(t *testing.T) {
+	claims := getClaimsCustom(Claims{User: &User{}, Sid: "session-id"}, nil, nil)
+	if claims["sid"] != "session-id" {
+		t.Fatalf("sid = %#v", claims["sid"])
+	}
+}
