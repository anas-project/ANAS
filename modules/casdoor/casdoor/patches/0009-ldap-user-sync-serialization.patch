+package object
+
+import (
+	"slices"
+	"sync"
+	"testing"
+	"time"
+)
+
+// fakeLdapImport models upstream's lookup-then-insert import and its "<uid>_"
+// name-clash fallback for a user whose uidNumber is empty.
+type fakeLdapImport struct {
+	mu      sync.Mutex
+	anchors map[string]bool
+	names   []string
+}
+
+func (f *fakeLdapImport) sync(owner string, users []LdapUser, ldapId string) ([]LdapUser, []LdapUser, error) {
+	var missing []LdapUser
+	f.mu.Lock()
+	for _, user := range users {
+		if !f.anchors[user.Uuid] {
+			missing = append(missing, user)
+		}
+	}
+	f.mu.Unlock()
+	time.Sleep(50 * time.Millisecond)
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	for _, user := range missing {
+		name := user.Uid
+		if slices.Contains(f.names, name) {
+			name += "_" + user.UidNumber
+		}
+		f.anchors[user.Uuid] = true
+		f.names = append(f.names, name)
+	}
+	return nil, nil, nil
+}
+
+func runConcurrentLdapSyncs(run func(string, []LdapUser, string) ([]LdapUser, []LdapUser, error)) {
+	users := []LdapUser{{Uid: "alice", Uuid: "anchor-alice"}}
+	start := make(chan struct{})
+	var runs sync.WaitGroup
+	for range 2 {
+		runs.Add(1)
+		go func() {
+			defer runs.Done()
+			<-start
+			_, _, _ = run("anas", users, "anas/ad")
+		}()
+	}
+	close(start)
+	runs.Wait()
+}
+
+func TestAnasLdapUserSyncSerializesImports(t *testing.T) {
+	unlocked := &fakeLdapImport{anchors: map[string]bool{}}
+	runConcurrentLdapSyncs(unlocked.sync)
+	if !slices.Equal(unlocked.names, []string{"alice", "alice_"}) {
+		t.Fatalf("unserialized imports did not reproduce the duplicate: %v", unlocked.names)
+	}
+
+	original := anasSyncLdapUsers
+	defer func() { anasSyncLdapUsers = original }()
+	locked := &fakeLdapImport{anchors: map[string]bool{}}
+	anasSyncLdapUsers = locked.sync
+	runConcurrentLdapSyncs(SyncLdapUsers)
+	if !slices.Equal(locked.names, []string{"alice"}) {
+		t.Fatalf("serialized imports created %v", locked.names)
+	}
+}
