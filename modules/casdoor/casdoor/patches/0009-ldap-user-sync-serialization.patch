+package object
+
+import "sync"
+
+// SyncLdapUsers looks up existing LDAP UUIDs and then inserts the missing users.
+// Auto-sync, the sync-ldap-users API and the administration UI run it in this
+// process; overlapping runs both miss a new UUID and the second insert becomes
+// "<uid>_" with the same directory identity. Serialize every run.
+var (
+	anasLdapUserSyncMutex sync.Mutex
+	anasSyncLdapUsers     = syncLdapUsers
+)
