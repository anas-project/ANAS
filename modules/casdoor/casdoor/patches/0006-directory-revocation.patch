+package object
+
+import (
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/casdoor/casdoor/util"
+	"github.com/xorm-io/core"
+)
+
+var anasDirectoryMutex sync.Mutex
+
+// This snapshot contains identifiers, never bearer tokens or caller supplied URLs.
+type AnasRevocation struct {
+	Owner        string             `json:"owner"`
+	UserId       string             `json:"userId"`
+	Name         string             `json:"name"`
+	Subject      string             `json:"subject"`
+	All          bool               `json:"all"`
+	Applications []string           `json:"applications"`
+	Tokens       []string           `json:"tokens"`
+	Targets      []AnasLogoutTarget `json:"targets"`
+	Sessions     []*Session         `json:"sessions"`
+}
+
+type AnasLogoutTarget struct {
+	Application string `json:"application"`
+	Sid         string `json:"sid"`
+	Subject     string `json:"subject,omitempty"`
+}
+
+func checkAnasRevocation(r *AnasRevocation) (*User, error) {
+	if r.Owner != "anas" || r.UserId == "" {
+		return nil, fmt.Errorf("directory revocation requires an anas user id")
+	}
+	u, err := GetUserByUserId("anas", r.UserId)
+	if err != nil {
+		return nil, err
+	}
+	if u == nil {
+		return nil, fmt.Errorf("directory user no longer exists")
+	}
+	for _, name := range r.Applications {
+		a, err := GetApplication(util.GetId("admin", name))
+		if err != nil {
+			return nil, err
+		}
+		if a == nil || a.Organization != "anas" {
+			return nil, fmt.Errorf("invalid directory application")
+		}
+	}
+	for _, target := range r.Targets {
+		if !slices.Contains(r.Applications, target.Application) || target.Sid == "" {
+			return nil, fmt.Errorf("invalid directory logout target")
+		}
+	}
+	return u, nil
+}
+
+func PrepareAnasRevocation(r *AnasRevocation) (*AnasRevocation, error) {
+	u, err := checkAnasRevocation(r)
+	if err != nil {
+		return nil, err
+	}
+	r.Name = u.Name
+	r.Subject = u.ExternalId
+	r.Tokens = nil
+	r.Targets = nil
+	r.Sessions = nil
+	var tokens []*Token
+	if err := ormer.Engine.Where(map[string]interface{}{"organization": "anas", "user_id": u.Id}).Find(&tokens); err != nil {
+		return nil, err
+	}
+	seen := map[string]bool{}
+	for _, token := range tokens {
+		if token.Owner != "admin" || !slices.Contains(r.Applications, token.Application) {
+			continue
+		}
+		r.Tokens = append(r.Tokens, token.Name)
+		// Unredeemed codes never established an RP session. Explicit logout
+		// already retired grants; retain their deletion without another notice.
+		if !token.CodeIsUsed || token.ExpiresIn <= 0 {
+			continue
+		}
+		sid, err := anasTokenSessionId(token)
+		if err != nil {
+			return nil, err
+		}
+		if sid == "" {
+			return nil, fmt.Errorf("directory token has no OIDC session id")
+		}
+		key := token.Application + "/" + sid
+		if !seen[key] {
+			r.Targets = append(r.Targets, AnasLogoutTarget{Application: token.Application, Sid: sid, Subject: anasTokenSubject(token)})
+			seen[key] = true
+		}
+	}
+	sessions, err := GetUserSessions("anas", u.Name)
+	if err != nil {
+		return nil, err
+	}
+	for _, session := range sessions {
+		if r.All || slices.Contains(r.Applications, session.Application) {
+			r.Sessions = append(r.Sessions, session)
+		}
+	}
+	return r, nil
+}
+
+// Delete exact issued sessions, including refresh rotations of the same sid.
+// A later authorization has a different sid and must survive replay.
+func RevokeAnasSessions(r *AnasRevocation) error {
+	anasDirectoryMutex.Lock()
+	defer anasDirectoryMutex.Unlock()
+	u, err := checkAnasRevocation(r)
+	if err != nil {
+		return err
+	}
+	var tokens []*Token
+	if err := ormer.Engine.Where(map[string]interface{}{"organization": "anas", "user_id": u.Id}).Find(&tokens); err != nil {
+		return err
+	}
+	liveParents := map[string]bool{}
+	liveAppParents := map[string]bool{}
+	for _, token := range tokens {
+		sid, err := anasTokenSessionId(token)
+		if err != nil {
+			return err
+		}
+		captured := token.Owner == "admin" && slices.Contains(r.Tokens, token.Name)
+		for _, target := range r.Targets {
+			if token.Owner == "admin" && target.Application == token.Application && target.Sid == sid {
+				captured = true
+			}
+		}
+		if captured {
+			if _, err := DeleteToken(token); err != nil {
+				return err
+			}
+		} else if token.SessionId != "" {
+			liveParents[token.SessionId] = true
+			liveAppParents[token.Application+"/"+token.SessionId] = true
+		}
+	}
+	for _, saved := range r.Sessions {
+		if saved.Owner != "anas" || saved.Name != r.Name || (!r.All && !slices.Contains(r.Applications, saved.Application)) {
+			return fmt.Errorf("invalid captured directory session")
+		}
+		current, err := GetSingleSession(saved.GetId())
+		if err != nil {
+			return err
+		}
+		if current == nil {
+			continue
+		}
+		for _, parent := range saved.SessionId {
+			if r.All && !liveParents[parent] {
+				DeleteBeegoSession([]string{parent})
+			}
+			if !liveAppParents[saved.Application+"/"+parent] {
+				current.SessionId = util.DeleteVal(current.SessionId, parent)
+			}
+		}
+		if len(current.SessionId) == 0 {
+			if _, err := ormer.Engine.ID(core.PK{current.Owner, current.Name, current.Application}).Delete(&Session{}); err != nil {
+				return err
+			}
+		} else {
+			if _, err := ormer.Engine.ID(core.PK{current.Owner, current.Name, current.Application}).Cols("session_id").Update(current); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func DeliverAnasLogout(r *AnasRevocation, target AnasLogoutTarget, host string) error {
+	if _, err := checkAnasRevocation(r); err != nil {
+		return err
+	}
+	if !slices.Contains(r.Targets, target) {
+		return fmt.Errorf("logout target was not captured")
+	}
+	app, err := GetApplication(util.GetId("admin", target.Application))
+	if err != nil {
+		return err
+	}
+	if app == nil || app.BackchannelLogoutUri == "" {
+		return fmt.Errorf("application has no OIDC back-channel logout endpoint")
+	}
+	if strings.TrimSpace(r.Subject) == "" || r.Subject != strings.TrimSpace(r.Subject) {
+		return fmt.Errorf("captured directory subject is invalid")
+	}
+	// Each captured token keeps its own subject, including an anchor repair.
+	subject := target.Subject
+	if subject == "" {
+		subject = r.Subject
+	}
+	token, err := generateLogoutToken(app, &User{Owner: "anas", ExternalId: subject}, target.Sid, host)
+	if err != nil {
+		return err
+	}
+	body := url.Values{"logout_token": {token}}
+	request, err := http.NewRequest(http.MethodPost, app.BackchannelLogoutUri, strings.NewReader(body.Encode()))
+	if err != nil {
+		return fmt.Errorf("invalid registered logout endpoint")
+	}
+	request.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	client := &http.Client{Timeout: 5 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	response, err := client.Do(request)
+	if err != nil {
+		return fmt.Errorf("OIDC logout delivery failed")
+	}
+	defer response.Body.Close()
+	_, _ = io.Copy(io.Discard, io.LimitReader(response.Body, 4096))
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		return fmt.Errorf("OIDC logout endpoint returned HTTP %d", response.StatusCode)
+	}
+	return nil
+}
+
+// Explicit logout destroys a central parent and invalidates only its grants.
+// Directory application revocation uses captured OIDC sid instead.
+func ExpireAnasParentTokens(organization, username, parent string) error {
+	anasDirectoryMutex.Lock()
+	defer anasDirectoryMutex.Unlock()
+	if organization != "anas" || parent == "" {
+		return nil
+	}
+	_, err := ormer.Engine.Where(map[string]interface{}{"organization": organization, "user": username, "session_id": parent}).Cols("expires_in").Update(&Token{ExpiresIn: 0})
+	return err
+}
