+// Only decode server-owned token records; this is not an authentication parser.
+func anasTokenSubject(token *Token) string {
+	parts := strings.Split(token.AccessToken, ".")
+	if len(parts) != 3 {
+		return ""
+	}
+	body, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil {
+		return ""
+	}
+	var claims struct {
+		Sub string `json:"sub"`
+	}
+	if json.Unmarshal(body, &claims) != nil {
+		return ""
+	}
+	return claims.Sub
+}
+
+func anasTokenSessionId(token *Token) (string, error) {
+	parts := strings.Split(token.AccessToken, ".")
+	if len(parts) != 3 {
+		return "", fmt.Errorf("invalid stored JWT")
+	}
+	payload, err := jwt.NewParser().DecodeSegment(parts[1])
+	if err != nil {
+		return "", err
+	}
+	var claims struct {
+		Sid string `json:"sid"`
+	}
+	if err := json.Unmarshal(payload, &claims); err != nil {
+		return "", err
+	}
+	return claims.Sid, nil
