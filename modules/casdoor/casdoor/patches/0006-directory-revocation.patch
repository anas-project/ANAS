+package controllers
+
+import (
+	"crypto/subtle"
+	"encoding/json"
+	"github.com/casdoor/casdoor/object"
+)
+
+// Only the module's built-in service client can snapshot or revoke directory
+// sessions. Ordinary OAuth clients and interactive administrators are excluded.
+func (c *ApiController) anasDirectoryClient() bool {
+	id, secret, ok := c.Ctx.Request.BasicAuth()
+	if !ok || id == "" || secret == "" {
+		return false
+	}
+	app, err := object.GetApplication("admin/app-built-in")
+	return err == nil && app != nil && app.Organization == "built-in" &&
+		subtle.ConstantTimeCompare([]byte(id), []byte(app.ClientId)) == 1 &&
+		subtle.ConstantTimeCompare([]byte(secret), []byte(app.ClientSecret)) == 1
+}
+
+func (c *ApiController) AnasDirectoryRevocation() {
+	if !c.anasDirectoryClient() {
+		c.Ctx.Output.SetStatus(403)
+		c.ResponseError("directory service client required")
+		return
+	}
+	var request struct {
+		Owner    string                  `json:"owner"`
+		Action   string                  `json:"action"`
+		Snapshot object.AnasRevocation   `json:"snapshot"`
+		Target   object.AnasLogoutTarget `json:"target"`
+	}
+	if err := json.Unmarshal(c.Ctx.Input.RequestBody, &request); err != nil || request.Owner != "anas" {
+		c.ResponseError("invalid directory revocation request")
+		return
+	}
+	var err error
+	switch request.Action {
+	case "prepare":
+		var snapshot *object.AnasRevocation
+		snapshot, err = object.PrepareAnasRevocation(&request.Snapshot)
+		if err == nil {
+			c.ResponseOk(snapshot)
+			return
+		}
+	case "revoke":
+		err = object.RevokeAnasSessions(&request.Snapshot)
+	case "deliver":
+		err = object.DeliverAnasLogout(&request.Snapshot, request.Target, c.Ctx.Request.Host)
+	default:
+		c.ResponseError("invalid directory revocation action")
+		return
+	}
+	if err != nil {
+		c.ResponseError(err.Error())
+		return
+	}
+	c.ResponseOk(true)
+}
