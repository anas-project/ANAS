--- a/object/anas_subject.go
+++ b/object/anas_subject.go
@@ -0,0 +1,21 @@
+package object
+
+import (
+	"fmt"
+	"strings"
+)
+
+// ANAS directory users have one protocol subject, independent of login labels.
+// Recovery administrators belong to built-in and keep Casdoor's own identity.
+func getAnasSubject(user *User) (string, error) {
+	if user == nil {
+		return "", fmt.Errorf("cannot issue a subject without a user")
+	}
+	if user.Owner != "anas" {
+		return user.Id, nil
+	}
+	if user.ExternalId == "" || strings.TrimSpace(user.ExternalId) != user.ExternalId {
+		return "", fmt.Errorf("ANAS directory identity anchor is missing or invalid")
+	}
+	return user.ExternalId, nil
+}
