@@ -0,0 +1,24 @@
+package object
+
+import "time"
+
+// A Beego session value is accepted only for the immutable Casdoor user ID that set it.
+// Missing older sessions require a fresh login; issuance time is not authentication time.
+func AnasAuthenticationTime(userID string, subject, value interface{}) int64 {
+	owner, ok := subject.(string)
+	if !ok || owner == "" || owner != userID {
+		return 0
+	}
+	timestamp, ok := value.(int64)
+	if !ok {
+		return 0
+	}
+	return anasTokenAuthenticationTime([]int64{timestamp})
+}
+
+func anasTokenAuthenticationTime(values []int64) int64 {
+	if len(values) != 1 || values[0] <= 0 || values[0] > time.Now().Unix() {
+		return 0
+	}
+	return values[0]
+}
