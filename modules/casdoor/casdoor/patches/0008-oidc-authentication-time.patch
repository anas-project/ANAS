@@ -0,0 +1,42 @@
+package object
+
+import (
+	"testing"
+	"time"
+)
+
+func TestAnasAuthenticationTimeRequiresBoundVerifiedSession(t *testing.T) {
+	now := time.Now().Unix()
+	for _, tc := range []struct {
+		subject, value interface{}
+		expected       int64
+	}{
+		{"alice-id", now, now}, {"replacement-id", now, 0}, {nil, now, 0},
+		{"alice-id", "1234", 0}, {"alice-id", int64(0), 0},
+		{"alice-id", now + 3600, 0},
+	} {
+		if actual := AnasAuthenticationTime("alice-id", tc.subject, tc.value); actual != tc.expected {
+			t.Fatalf("authentication time = %d, expected %d", actual, tc.expected)
+		}
+	}
+}
+
+func TestAnasAuthenticationTimeCannotBeReplacedByCustomAttributes(t *testing.T) {
+	original := time.Now().Add(-time.Hour).Unix()
+	user := &User{Owner: "anas", Properties: map[string]string{"fake": "9999999999"}}
+	attributes := []*JwtItem{{Name: "auth_time", Category: "Existing Field", Value: "Properties.fake", Type: "String"}}
+	for _, timestamp := range []int64{original, 0} {
+		claims := Claims{User: user, AuthTime: timestamp}
+		custom := getClaimsCustom(claims, nil, attributes)
+		if timestamp == 0 {
+			if _, exists := custom["auth_time"]; exists {
+				t.Fatal("unverified authentication time was emitted")
+			}
+		} else if custom["auth_time"] != original {
+			t.Fatal("custom fields replaced original authentication time")
+		}
+		if getShortClaims(claims).AuthTime != timestamp || getClaimsWithoutThirdIdp(claims).AuthTime != timestamp || getStandardClaims(claims).AuthTime != timestamp {
+			t.Fatal("a token format dropped the original authentication time")
+		}
+	}
+}
