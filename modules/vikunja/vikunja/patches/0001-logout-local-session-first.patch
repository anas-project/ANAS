@@ -0,0 +1,110 @@
+import {beforeEach, describe, expect, it, vi} from 'vitest'
+import {createPinia, setActivePinia} from 'pinia'
+
+import {useAuthStore} from './auth'
+
+const {
+	postMock,
+	routerPushMock,
+	redirectToProviderOnLogoutMock,
+	disconnectMock,
+} = vi.hoisted(() => ({
+	postMock: vi.fn(),
+	routerPushMock: vi.fn(),
+	redirectToProviderOnLogoutMock: vi.fn(() => false),
+	disconnectMock: vi.fn(),
+}))
+
+vi.mock('@/helpers/auth', () => ({
+	refreshToken: vi.fn(),
+	getToken: vi.fn(() => localStorage.getItem('token')),
+	saveToken: vi.fn(),
+	removeToken: vi.fn(() => localStorage.removeItem('token')),
+}))
+
+vi.mock('@/router', () => ({
+	default: {push: routerPushMock},
+}))
+
+vi.mock('@/composables/useWebSocket', () => ({
+	useWebSocket: () => ({disconnect: disconnectMock, connect: vi.fn()}),
+}))
+
+vi.mock('@/helpers/fetcher', () => ({
+	HTTPFactory: () => ({
+		post: postMock,
+		get: vi.fn().mockResolvedValue({data: {}}),
+		request: vi.fn().mockResolvedValue({data: {}}),
+		interceptors: {
+			request: {use: vi.fn()},
+			response: {use: vi.fn()},
+		},
+	}),
+	AuthenticatedHTTPFactory: () => ({
+		post: vi.fn().mockResolvedValue({data: {}}),
+		get: vi.fn().mockResolvedValue({data: {}}),
+		request: vi.fn().mockResolvedValue({data: {}}),
+		interceptors: {
+			request: {use: vi.fn()},
+			response: {use: vi.fn()},
+		},
+	}),
+	getApiBaseUrl: () => 'http://localhost/api/v1/',
+}))
+
+vi.mock('@/helpers/redirectToProvider', () => ({
+	getRedirectUrlFromCurrentFrontendPath: vi.fn(),
+	redirectToProvider: vi.fn(),
+	redirectToProviderOnLogout: redirectToProviderOnLogoutMock,
+}))
+
+describe('auth store logout', () => {
+	beforeEach(() => {
+		setActivePinia(createPinia())
+		localStorage.clear()
+		sessionStorage.clear()
+		postMock.mockReset()
+		routerPushMock.mockReset().mockResolvedValue(undefined)
+		redirectToProviderOnLogoutMock.mockReset().mockReturnValue(false)
+		disconnectMock.mockReset()
+	})
+
+	it('clears the local session before the server logout resolves', async () => {
+		let resolvePost: (value: unknown) => void = () => undefined
+		postMock.mockImplementation(() => new Promise(resolve => {
+			resolvePost = resolve
+		}))
+		localStorage.setItem('token', 'captured-user-token')
+		localStorage.setItem('loggedInViaProvider', 'anas')
+
+		const store = useAuthStore()
+		store.setAuthenticated(true)
+		const logoutPromise = store.logout()
+
+		expect(localStorage.getItem('token')).toBeNull()
+		expect(store.authenticated).toBe(false)
+		expect(sessionStorage.getItem('justLoggedOut')).toBe('true')
+		expect(postMock).toHaveBeenCalledWith('user/logout', undefined, {
+			headers: {Authorization: 'Bearer captured-user-token'},
+			timeout: 5_000,
+		})
+		expect(routerPushMock).not.toHaveBeenCalled()
+
+		resolvePost({data: {}})
+		await logoutPromise
+		expect(routerPushMock).toHaveBeenCalledWith({name: 'user.login'})
+	})
+
+	it('stays locally logged out when the server logout fails', async () => {
+		postMock.mockRejectedValue(new Error('server unavailable'))
+		localStorage.setItem('token', 'captured-user-token')
+
+		const store = useAuthStore()
+		store.setAuthenticated(true)
+		await store.logout()
+
+		expect(localStorage.getItem('token')).toBeNull()
+		expect(store.authenticated).toBe(false)
+		expect(routerPushMock).toHaveBeenCalledWith({name: 'user.login'})
+	})
+})
