{
  "$schema": "https://raw.githubusercontent.com/Ylianst/MeshCentral/master/meshcentral-config-schema.json",
  "settings": {
    "_redirPort": 80,
    "_redirAliasPort": 80,
    "AgentPong": 300,
    "SelfUpdate": false,
    "AllowFraming": true,
    "agentLogDump": true,
    "agentCoreDump": true
  },
  "domains": {
    "": {
      "agentConfig": ["webSocketMaskOverride=1"],
      "NewAccounts": false,
      "showPasswordLogin": false,
      "unknownUserRootRedirect": "/auth-oidc",
      "ipkvm": true,
      "auth": "ldap",
      "ldapOptions": {
        "tlsOptions": {"rejectUnauthorized": true},
        "reconnect": true
      },
      "ldapUserKey": "anasIdentityAnchor",
      "ldapUserRealName": "{{{givenName}}} {{{sn}}}",
      "ldapUserGroups": "memberOf"
    }
  }
}
