.bin/
.anas-test/
.gocache/
.runtime*/
node_modules/
__pycache__/
*.py[cod]
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/.vitepress/versioned-dist-*/
# Local/private operator documents and their screenshots.
docs/private/
secrets.yml
# Site-specific deployment files may contain DNS credentials and passwords.
config.lnnj.com.cn.yml
test-env/reports/*
!test-env/reports/.gitkeep
# Per-machine remote-test targets and generated source bundles never enter Git.
test-env/remote/*.local.yml
test-env/.remote-test/

# Binaries built into the repository root. Anchored with a leading slash so the
# pattern cannot also match the cmd/<name>/ source directories.
/anas
/anasd
/anas-helper
/actions-controller

# macOS Finder metadata. Contributors without a global ignore would otherwise
# commit one of these into every directory they open in Finder.
.DS_Store

# Claude Code local state: per-machine settings and scratch worktrees.
.claude/settings.local.json
.claude/worktrees/
