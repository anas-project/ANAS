.bin/
.anas-test/
.gocache/
.runtime*/
node_modules/
__pycache__/
*.py[cod]
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/.vitepress/versioned-dist-*/
# Local/private operator documents and their screenshots.
docs/private/
secrets.yml
# Site-specific deployment files may contain DNS credentials and passwords.
config.lnnj.com.cn.yml
test-env/reports/*
!test-env/reports/.gitkeep
# Per-machine remote-test targets and generated source bundles never enter Git.
test-env/remote/*.local.yml
test-env/.remote-test/

# Binaries built into the repository root. Anchored with a leading slash so the
# pattern cannot also match the cmd/<name>/ source directories.
/anas
/anasd
/anas-helper
/actions-controller

# Binaries `go build` leaves in a Go program's own directory under modules/. Go
# names the output after the last element of the import path: the directory,
# unless a nested go.mod declares another module path, as oauth2_proxy's does
# with .../bootstrap. Git cannot match a file named after its parent, so each
# program is listed and every module's hook/ shares one pattern; add a line
# with each new program. Unignored, a local build also counts as a runtime
# change, and so a revision bump, in scripts/ci/module-revisions.sh.
/modules/*/hook/hook
/modules/ai_agent/orchestrator/orchestrator
/modules/casdoor/casdoor/helper/helper
/modules/ddns_go/ddns-go/reconcile/reconcile
/modules/forgejo/actions-controller/actions-controller
/modules/forgejo/forgejo/forgejo
/modules/incus/provisioner/provisioner
/modules/oauth2_proxy/oauth2_proxy/bootstrap
/modules/vikunja/vikunja/vikunja

# macOS Finder metadata. Contributors without a global ignore would otherwise
# commit one of these into every directory they open in Finder.
.DS_Store

# Claude Code local state: per-machine settings and scratch worktrees.
.claude/settings.local.json
.claude/worktrees/
