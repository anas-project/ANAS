[Unit]
Description=ANAS Incus fixed control relay
Documentation=https://anas.dev/
After=network-online.target incus.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=anas-incus-relay
Group=anas-incus-relay
# Keep the stored source below the host executor's root-private directory.
# Only this public configuration file enters the service's mount namespace.
BindReadOnlyPaths=/etc/anas/incus-control-relay.json:/run/anas-incus-control-relay.json
ExecStart=/usr/local/lib/anas/anas-incus-control-relay --config /run/anas-incus-control-relay.json
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/anas/incus-control-relay.json
# Interface/index/address readback uses route netlink. No network capability
# is granted: the relay still cannot configure an interface or firewall.
RestrictAddressFamilies=AF_INET AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
