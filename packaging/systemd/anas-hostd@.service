[Unit]
Description=ANAS one-request host action executor

[Service]
Type=exec
User=root
Group=root
ExecStart=/usr/local/lib/anas/anas-hostd --serve
Restart=no
KillMode=control-group
RuntimeMaxSec=615s
TimeoutStopSec=5s
UMask=0077
StateDirectory=anas-hostd
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Package installation and its maintainer scripts, system-account creation,
# the root-only confirmation claim and Incus state need these system trees.
# This is an audited full-root action service, NOT a DAC-only sandbox. Request
# data can never select an executable, package, path or script. Home and other
# trees remain protected; no optional architecture-specific path is required.
ReadWritePaths=/etc /usr /var /run /tmp
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallArchitectures=native
