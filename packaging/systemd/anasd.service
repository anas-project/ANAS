[Unit]
Description=ANAS administration console
Documentation=https://anas.dev/
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
ExecStart=/usr/local/bin/anasd --config /etc/anas/anasd.yml
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=-/var/lib/anas -/srv/anas -/srv/anas-backups
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
