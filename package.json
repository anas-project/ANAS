{
  "name": "anas-documentation",
  "private": true,
  "scripts": {
    "docs:dev": "node scripts/ci/dev-docs.mjs",
    "docs:build": "node scripts/ci/build-versioned-docs.mjs",
    "docs:test-versions": "node scripts/ci/docs-version-test.mjs",
    "docs:check-requirements": "node scripts/ci/requirement-coverage.mjs && go run ./cmd/gen-test-case-docs --check",
    "docs:test-requirements": "node scripts/ci/requirement-coverage-test.mjs && node scripts/ci/requirement-docs-test.mjs && node scripts/ci/requirement-status-test.mjs && go test ./internal/testcasecatalog ./cmd/gen-test-case-docs",
    "docs:check-status": "node scripts/ci/document-status.mjs",
    "docs:test-status": "node scripts/ci/document-status-test.mjs && node scripts/ci/plan-status-test.mjs",
    "docs:preview": "vitepress preview docs",
    "e2e:iam-logout": "playwright test --config test-env/playwright/iam-logout.config.mjs",
    "test:iam-logout-report": "node --test test-env/playwright/sanitized-reporter.test.mjs",
    "docs:requirement-status": "node scripts/ci/requirement-status.mjs",
    "docs:plan-status": "node scripts/ci/plan-status.mjs",
    "docs:check-plan-status": "node scripts/ci/plan-status.mjs --check",
    "docs:check-requirement-status": "node scripts/ci/requirement-status.mjs --check",
    "test-cases:generate": "go run ./cmd/gen-test-case-docs",
    "test-cases:check": "go run ./cmd/gen-test-case-docs --check",
    "test-cases:digests": "go run ./cmd/gen-test-case-docs --print-digests",
    "test-cases:review": "go run ./cmd/gen-test-case-docs --review-diff HEAD",
    "test-remote-contract": "go test ./internal/remotetest ./cmd/remote-test ./cmd/anas-test-helper",
    "test-upgrades:catalog": "go run ./cmd/check-upgrade-tests",
    "test-upgrades:core": "bash scripts/ci/core-upgrade-e2e.sh v0.1.0 && latest_tag=$(git tag --list 'v[0-9]*' --sort=-version:refname | head -n 1) && test -n \"$latest_tag\" && { test \"$latest_tag\" = v0.1.0 || bash scripts/ci/core-upgrade-e2e.sh \"$latest_tag\"; }",
    "test-upgrades:fixtures": "bash scripts/ci/module-upgrade-fixture-compatibility.sh image-release/46-2",
    "test-upgrades:report": "bash test-env/scripts/test-upgrade-report.sh",
    "test-upgrades:runtime": "bash test-env/scripts/test-upgrade-runtime-export.sh",
    "test-upgrades:readiness": "bash test-env/scripts/test-upgrade-service-readiness.sh",
    "test-upgrades:cleanup": "bash test-env/scripts/test-upgrade-workspace-cleanup.sh",
    "test-upgrades:old-compat": "bash test-env/scripts/test-upgrade-old-compat.sh",
    "test-upgrades:suite-targets": "bash test-env/scripts/test-upgrade-suite-targets.sh",
    "test-upgrades:authentik-probes": "bash test-env/scripts/test-authentik-upgrade-probes.sh",
    "test-upgrades:proxy-boundary": "bash test-env/scripts/test-upgrade-proxy-boundary.sh",
    "e2e:vikunja-browser": "playwright test --config test-env/playwright/vikunja-browser.config.mjs",
    "e2e:vikunja-llng-browser": "playwright test --config test-env/playwright/vikunja-llng-browser.config.mjs",
    "e2e:vikunja-authentik-matrix-browser": "playwright test --config test-env/playwright/vikunja-authentik-matrix-browser.config.mjs",
    "e2e:vikunja-load-browser": "playwright test --config test-env/playwright/vikunja-load-browser.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "vitepress": "1.6.4"
  }
}
