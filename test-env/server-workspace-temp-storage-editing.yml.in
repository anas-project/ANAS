# TEST_CASES: TEMP-T-021 TEMP-T-023
# Rendered only by server-workspace-temp-storage-editing-e2e.py after it verifies
# this run's private Docker, mount namespace and network namespace.
modules:
  lego: {}
  traefik:
    config:
      base_port: @ENTRY_PORT@
  samba_dc:
    config:
      dns_cache_size: 64M
      dns_forwarders: "223.5.5.5"
  postgres:
    config:
      adminer_enabled: false
  llng:
    config:
      db_type: postgres
      enable_test: false
  eturnal:
    config:
      port: @TURN_PORT@
  nextcloud:
    config:
      db_type: postgres
      iam_protocol: oidc
      talk_enabled: false
      memories_enabled: false
      memory_limit: 512M
  collabora: {}
identity:
  iam:
    provider: llng
global:
  base_domain: @DOMAIN@
  email: test@@DOMAIN@
  timezone: Asia/Singapore
  virtual_domain: true
  container_prefix: @PREFIX@
  network_prefix: @PREFIX@
  host_ip: @ENTRY_IP@
  dns_server: 223.5.5.5
  temp_path: @TEMP_A@
  chinese_speedup: false
  chinese_build_speedup: false
env:
  # Public dependency downloads use only this run's host-side relay.
  HTTP_PROXY: "http://@GATEWAY@:3128"
  HTTPS_PROXY: "http://@GATEWAY@:3128"
  NO_PROXY: "localhost,127.0.0.1,.@DOMAIN@,10.253.71.0/24,172.27.71.0/24,172.28.0.0/16"
  DOCKER_SOCKET_PATH: @DOCKER_SOCKET@
  NETWORK_NAMESPACE_PATH: @NETWORK_NAMESPACE@
  SAMBA_DC_HOST_IP: @ENTRY_IP@
  SAMBA_DC_INTERFACES: @INTERFACE@
